{
  "name": "your-open-shelf",
  "version": "0.1.0",
  "private": true,
  "description": "YOS — Your Open Shelf: a credit-based peer-to-peer physical book exchange.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "prettier --check . && eslint . && tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "jobs": "tsx scripts/jobs.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle:check": "tsx scripts/check-bundle.ts",
    "check": "npm run lint && npm test && npm run build && npm run bundle:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
