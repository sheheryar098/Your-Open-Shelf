# PostgreSQL connection string
DATABASE_URL=postgres://yos:yos@localhost:5432/yos
# Public base URL, used in email links
APP_URL=http://localhost:3000
# Where uploaded photos / evidence are stored (use object storage in production)
UPLOAD_DIR=storage/uploads
# Shared secret for the scheduled-jobs endpoint (POST /api/v1/jobs with header x-jobs-secret)
JOBS_SECRET=change-me
# Show the development email outbox at /dev/outbox (never enable in production)
ENABLE_DEV_OUTBOX=true
# Optional ISBN metadata lookup: "openlibrary" or empty to disable
CATALOG_LOOKUP=
